<UserControl x:Class="WPF_LoginForm.Views.CadastrarResidencia"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="800">

    <Grid Margin="20">
        <Border CornerRadius="15" Background="#15FFFFFF" Padding="30">
            <StackPanel x:Name="ContainerPrincipal">
                <TextBlock Text="CADASTRAR NOVA RESIDÊNCIA" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,0,0,25"/>

                <TextBlock Text="NOME DA RESIDÊNCIA (EX: MINHA CASA)" Foreground="DarkGray" Margin="0,0,0,5"/>
                <TextBox x:Name="txtNomeResidencia" Height="35" Background="#20FFFFFF" Foreground="White" 
                         BorderThickness="0,0,0,1" VerticalContentAlignment="Center" Padding="5,0" Margin="0,0,0,15"/>

                <TextBlock Text="LOGRADOURO (RUA / AVENIDA)" Foreground="DarkGray" Margin="0,0,0,5"/>
                <TextBox x:Name="txtEndereco" Height="35" Background="#20FFFFFF" Foreground="White" 
                         BorderThickness="0,0,0,1" VerticalContentAlignment="Center" Padding="5,0" Margin="0,0,0,15"/>

                <Grid Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="NÚMERO" Foreground="DarkGray" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtNumero" Height="35" Background="#20FFFFFF" Foreground="White" 
                                 BorderThickness="0,0,0,1" VerticalContentAlignment="Center" Padding="5,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="BAIRRO" Foreground="DarkGray" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtBairro" Height="35" Background="#20FFFFFF" Foreground="White" 
                                 BorderThickness="0,0,0,1" VerticalContentAlignment="Center" Padding="5,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="CIDADE" Foreground="DarkGray" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtCidade" Height="35" Background="#20FFFFFF" Foreground="White" 
                                 BorderThickness="0,0,0,1" VerticalContentAlignment="Center" Padding="5,0"/>
                    </StackPanel>
                </Grid>

                <Border x:Name="borderCodigo" Visibility="Collapsed" Background="#1500FF00" CornerRadius="10" Padding="15" Margin="0,0,0,25">
                    <StackPanel>
                        <TextBlock Text="CÓDIGO DE VÍNCULO GERADO" Foreground="#FF00FF00" FontWeight="Bold" HorizontalAlignment="Center" FontSize="12"/>
                        <TextBox x:Name="txtCodigoVinculo" IsReadOnly="True" FontSize="28" TextAlignment="Center" 
                                 Background="Transparent" Foreground="White" BorderThickness="0" FontWeight="ExtraBold"
                                 Text="------" Margin="5"/>
                        <TextBlock Text="COMPARTILHE ESTE CÓDIGO COM SUA FAMÍLIA" Foreground="DarkGray" FontSize="10" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Button x:Name="btnSalvar" Content="SALVAR E GERAR CÓDIGO" Click="btnSalvarResidencia_Click" Height="45" 
                        Background="#462AD8" Foreground="White" FontWeight="Bold" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="22">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>