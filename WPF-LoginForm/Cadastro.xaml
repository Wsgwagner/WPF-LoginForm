<Window x:Class="WPF_LoginForm.Cadastro"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cadastro de Usuários" Height="550" Width="400" 
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="Transparent" 
        AllowsTransparency="True" MouseDown="Window_MouseDown">

    <Border CornerRadius="15" Background="#181735" Padding="30">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,20">
                <Button Content="X" Click="btnClose_Click" DockPanel.Dock="Right" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="16" FontWeight="Bold"/>
                <TextBlock Text="NOVO USUÁRIO" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
            </DockPanel>

            <StackPanel Grid.Row="1">
                <TextBlock x:Name="lblId" Visibility="Collapsed"/>

                <TextBlock Text="Nome" Foreground="DarkGray" Margin="0,5"/>
                <TextBox x:Name="txtName" Height="35" Background="#2A294F" Foreground="White" BorderThickness="0"/>

                <TextBlock Text="Sobrenome" Foreground="DarkGray" Margin="0,5,0,5"/>
                <TextBox x:Name="txtLastName" Height="35" Background="#2A294F" Foreground="White" BorderThickness="0"/>

                <TextBlock Text="Usuário" Foreground="DarkGray" Margin="0,5,0,5"/>
                <TextBox x:Name="txtUsername" Height="35" Background="#2A294F" Foreground="White" BorderThickness="0"/>

                <TextBlock Text="Email" Foreground="DarkGray" Margin="0,5,0,5"/>
                <TextBox x:Name="txtEmail" Height="35" Background="#2A294F" Foreground="White" BorderThickness="0"/>

                <TextBlock Text="Senha" Foreground="DarkGray" Margin="0,5,0,5"/>
                <PasswordBox x:Name="txtPassword" Height="35" Background="#2A294F" Foreground="White"/>

                <Button x:Name="btnSave" Content="CADASTRAR" Margin="0,30,0,0" Height="45" Background="#28AEED" Foreground="White" FontWeight="Bold" Click="btnSave_Click"/>

                <Button x:Name="btnBack" Content="CANCELAR" Margin="0,10,0,0" Background="Transparent" Foreground="Gray" BorderThickness="0" Click="btnBack_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>