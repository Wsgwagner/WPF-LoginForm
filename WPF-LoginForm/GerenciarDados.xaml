<Window x:Class="WPF_LoginForm.Views.GerenciarDados"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IA HOME - Gerenciamento" Height="800" Width="950"
        WindowStyle="None" AllowsTransparency="True" Background="#181735" 
        WindowStartupLocation="CenterScreen" MouseDown="Window_MouseDown">

    <Border CornerRadius="15" BorderBrush="#28AEED" BorderThickness="1">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="GERENCIAMENTO IA HOME" Foreground="White" FontSize="20" FontWeight="Bold"/>
                <Button Content="✕" Click="CloseWindow" HorizontalAlignment="Right" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="18"/>
            </DockPanel>

            <DataGrid x:Name="dgGerenciamento" Grid.Row="1" AutoGenerateColumns="False" 
                      Background="Transparent" Foreground="White" RowBackground="#15FFFFFF" 
                      SelectionMode="Single" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="CATEGORIA" Binding="{Binding Categoria}" Width="110"/>
                    <DataGridTextColumn Header="NOME" Binding="{Binding Nome}" Width="*"/>
                    <DataGridTextColumn Header="EMAIL / LOCAL" Binding="{Binding Comodo}" Width="*"/>
                    <DataGridTextColumn Header="NÍVEL / TIPO" Binding="{Binding Tipo}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="2" Margin="0,15,0,0" Background="#10FFFFFF" CornerRadius="10" Padding="15">
                <StackPanel>
                    <TextBlock Text="📝 EDITAR REGISTRO" Foreground="#28AEED" FontWeight="Bold" Margin="0,0,0,10"/>

                    <UniformGrid Columns="3">
                        <StackPanel Margin="5">
                            <TextBlock Text="Nome" Foreground="Gray" FontSize="11"/>
                            <TextBox x:Name="txtNome" Text="{Binding SelectedItem.Nome, ElementName=dgGerenciamento, UpdateSourceTrigger=PropertyChanged}" Background="#20FFFFFF" Foreground="White" Padding="5"/>
                        </StackPanel>

                        <StackPanel Margin="5">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem.Categoria, ElementName=dgGerenciamento}" Value="USUÁRIO">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Sobrenome" Foreground="Gray" FontSize="11"/>
                            <TextBox x:Name="txtSobrenome" Text="{Binding SelectedItem.Sobrenome, ElementName=dgGerenciamento, UpdateSourceTrigger=PropertyChanged}" Background="#20FFFFFF" Foreground="White" Padding="5"/>
                        </StackPanel>

                        <StackPanel Margin="5">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem.Categoria, ElementName=dgGerenciamento}" Value="USUÁRIO">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Telefone" Foreground="Gray" FontSize="11"/>
                            <TextBox x:Name="txtTelefone" Text="{Binding SelectedItem.Telefone, ElementName=dgGerenciamento, UpdateSourceTrigger=PropertyChanged}" Background="#20FFFFFF" Foreground="White" Padding="5"/>
                        </StackPanel>

                        <StackPanel Margin="5">
                            <TextBlock Text="E-mail / Cômodo" Foreground="Gray" FontSize="11"/>
                            <TextBox x:Name="txtComodo" Text="{Binding SelectedItem.Comodo, ElementName=dgGerenciamento, UpdateSourceTrigger=PropertyChanged}" Background="#20FFFFFF" Foreground="White" Padding="5"/>
                        </StackPanel>

                        <StackPanel Margin="5">
                            <TextBlock Text="Nível / Tipo" Foreground="Gray" FontSize="11"/>
                            <TextBox x:Name="txtTipo" Text="{Binding SelectedItem.Tipo, ElementName=dgGerenciamento, UpdateSourceTrigger=PropertyChanged}" Background="#20FFFFFF" Foreground="White" Padding="5"/>
                        </StackPanel>
                    </UniformGrid>

                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedItem.Categoria, ElementName=dgGerenciamento}" Value="USUÁRIO">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="🔐 ALTERAR SENHA" Foreground="#28AEED" FontWeight="Bold" Margin="0,15,0,5"/>
                        <UniformGrid Columns="2">
                            <PasswordBox x:Name="txtSenhaAntiga" Margin="5" Padding="5" Background="#20FFFFFF" Foreground="White"/>
                            <PasswordBox x:Name="txtSenhaNova" Margin="5" Padding="5" Background="#20FFFFFF" Foreground="White"/>
                        </UniformGrid>
                    </StackPanel>

                    <Button Content="SALVAR ALTERAÇÕES" Click="EditAction" Margin="5,15,5,0" Padding="12" Background="#28AEED" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>