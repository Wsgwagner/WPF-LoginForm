<Window x:Class="WPF_LoginForm.Views.GerenciarDados"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IA HOME - Gerenciamento" Height="850" Width="1000"
        WindowStyle="None" AllowsTransparency="True" Background="#181735" 
        WindowStartupLocation="CenterScreen" MouseDown="Window_MouseDown">

    <Border CornerRadius="15" BorderBrush="#28AEED" BorderThickness="1">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="GERENCIAMENTO GLOBAL IA HOME" Foreground="White" FontSize="20" FontWeight="Bold"/>
                <Button Content="✕" Click="CloseWindow" HorizontalAlignment="Right" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="18" Cursor="Hand"/>
            </DockPanel>

            <DataGrid x:Name="dgGerenciamento" Grid.Row="1" ItemsSource="{Binding ListaGeral}" 
                      AutoGenerateColumns="False" Background="Transparent" Foreground="White" 
                      RowBackground="#15FFFFFF" SelectionMode="Single" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="CATEGORIA" Binding="{Binding Categoria}" Width="100"/>
                    <DataGridTextColumn Header="NOME" Binding="{Binding Nome}" Width="*"/>
                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="Ligado">
                                        <Setter Property="Foreground" Value="LightGreen"/>
                                    </Trigger>
                                    <Trigger Property="Text" Value="Desligado">
                                        <Setter Property="Foreground" Value="#FF6B6B"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="LOCAL / EMAIL" Binding="{Binding Comodo}" Width="*"/>
                    <DataGridTextColumn Header="TIPO / NÍVEL" Binding="{Binding Tipo}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="2" Margin="0,15,0,0">
                <Border Background="#10FFFFFF" CornerRadius="10" Padding="15" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock x:Name="txtTituloEdicao" Text="📝 EDITAR SELECIONADO" Foreground="#28AEED" FontWeight="Bold" Margin="0,0,0,10"/>
                        <UniformGrid Columns="2">
                            <StackPanel Margin="5">
                                <TextBlock Text="Nome" Foreground="Gray" FontSize="11"/>
                                <TextBox x:Name="txtNome" Text="{Binding SelectedItem.Nome, ElementName=dgGerenciamento}" Background="#20FFFFFF" Foreground="White" Padding="5"/>
                            </StackPanel>
                            <StackPanel Margin="5">
                                <TextBlock Text="Status" Foreground="Gray" FontSize="11"/>
                                <ComboBox x:Name="cbStatus" Background="#20FFFFFF" Padding="5">
                                    <ComboBoxItem Content="Ligado"/>
                                    <ComboBoxItem Content="Desligado"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="5">
                                <TextBlock x:Name="lblComodo" Text="Local / Email" Foreground="Gray" FontSize="11"/>
                                <TextBox x:Name="txtComodo" Text="{Binding SelectedItem.Comodo, ElementName=dgGerenciamento}" Background="#20FFFFFF" Foreground="White" Padding="5"/>
                            </StackPanel>
                            <StackPanel Margin="5">
                                <TextBlock x:Name="lblTipo" Text="Tipo / Nível" Foreground="Gray" FontSize="11"/>
                                <TextBox x:Name="txtTipo" Text="{Binding SelectedItem.Tipo, ElementName=dgGerenciamento}" Background="#20FFFFFF" Foreground="White" Padding="5"/>
                            </StackPanel>
                        </UniformGrid>

                        <StackPanel x:Name="pnlSeguranca" Visibility="Collapsed" Margin="0,10,0,0">
                            <UniformGrid Columns="2">
                                <StackPanel Margin="5">
                                    <TextBlock Text="Senha Atual" Foreground="Gray" FontSize="10"/>
                                    <PasswordBox x:Name="txtSenhaAntiga" Background="#20FFFFFF" Foreground="White" Padding="5"/>
                                </StackPanel>
                                <StackPanel Margin="5">
                                    <TextBlock Text="Nova Senha" Foreground="Gray" FontSize="10"/>
                                    <PasswordBox x:Name="txtSenhaNova" Background="#20FFFFFF" Foreground="White" Padding="5"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button x:Name="btnExcluir" Content="EXCLUIR" Click="DeleteAction" Margin="5" Padding="20,8" Background="#FF4444" Foreground="White" FontWeight="Bold"/>
                            <Button x:Name="btnSalvarGeral" Content="SALVAR ALTERAÇÕES" Click="EditAction" Margin="5" Padding="20,8" Background="#462AD8" Foreground="White" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="#10FFFFFF" CornerRadius="10" Padding="15">
                    <StackPanel>
                        <TextBlock Text="🏠 DADOS DA RESIDÊNCIA" Foreground="#28AEED" FontWeight="Bold" Margin="0,0,0,10"/>
                        <UniformGrid Columns="3">
                            <TextBox x:Name="txtResNome" Background="#20FFFFFF" Foreground="White" Margin="5" Padding="5"/>
                            <TextBox x:Name="txtResEnd" Background="#20FFFFFF" Foreground="White" Margin="5" Padding="5"/>
                            <TextBox x:Name="txtResCidade" Background="#20FFFFFF" Foreground="White" Margin="5" Padding="5"/>
                        </UniformGrid>
                        <Button x:Name="btnSalvarResidencia" Content="ATUALIZAR RESIDÊNCIA" Click="SaveResidencia_Click" Margin="5,10,5,0" Padding="8" Background="#28AEED" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>