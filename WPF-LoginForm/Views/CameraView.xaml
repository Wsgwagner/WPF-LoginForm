<Window x:Class="WPF_LoginForm.Views.CameraView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monitoramento IA HOME" Height="450" Width="800"
        WindowStartupLocation="CenterOwner" Background="#060531" AllowsTransparency="True" WindowStyle="None">

    <Border BorderThickness="2" CornerRadius="15">
        <Border.BorderBrush>
            <LinearGradientBrush>
                <GradientStop Color="#462AD8" Offset="0"/>
                <GradientStop Color="#DA34AE" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="15,5">
                <TextBlock Text="🎥 LIVE STREAMING - " Foreground="White" FontWeight="Bold"/>
                <TextBlock x:Name="lblNomeEquip" Text="CÂMERA" Foreground="#28AEED"/>
            </StackPanel>

            <Button Content="X" HorizontalAlignment="Right" Click="CloseClick" Background="Transparent" Foreground="White" BorderThickness="0" Width="40"/>

            <Border Grid.Row="1" Background="Black" Margin="10" CornerRadius="5">
                <Image x:Name="imgVideo" Stretch="Uniform"/>
            </Border>

            <StatusBar Grid.Row="2" Background="#10FFFFFF" Foreground="White">
                <StatusBarItem>
                    <TextBlock x:Name="txtStatusIA" Text="IA: Processando frames..."/>
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </Border>
</Window>