<Window x:Class="WPF_LoginForm.Views.CameraView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IA HOME - Monitoramento" Height="500" Width="850"
        WindowStartupLocation="CenterOwner" AllowsTransparency="True" WindowStyle="None" Background="Transparent">

    <Border CornerRadius="20" BorderThickness="2" Background="#060531">
        <Border.BorderBrush>
            <LinearGradientBrush>
                <GradientStop Color="#462AD8" Offset="0"/>
                <GradientStop Color="#DA34AE" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                <TextBlock Text="🎥 MONITORAMENTO AO VIVO: " Foreground="White" FontSize="16" FontWeight="Bold"/>
                <TextBlock x:Name="lblNomeEquip" Text="CÂMERA" Foreground="#28AEED" FontSize="16"/>
            </StackPanel>

            <Button Content="✕" HorizontalAlignment="Right" Click="BtnFechar_Click" 
                    Background="Transparent" Foreground="White" FontSize="20" Width="50" BorderThickness="0" Cursor="Hand"/>

            <Border Grid.Row="1" Background="Black" Margin="15" CornerRadius="10" ClipToBounds="True">
                <Image x:Name="imgDisplay" Stretch="Uniform"/>
            </Border>

            <Border Grid.Row="2" Background="#10FFFFFF" CornerRadius="0,0,18,18">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <Ellipse Width="10" Height="10" Fill="#00FF00" Margin="0,0,10,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Style.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.2" Duration="0:0:1" AutoReverse="True"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock x:Name="txtStatusIA" Text="IA ATIVA: Analisando ambiente com YOLO..." Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>